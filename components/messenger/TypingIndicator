"use client";

export default function TypingIndicator(props) {
  const label = props.label;
  if (!label) return null;

  return (
    <div
      style={{
        display: "flex",
        alignItems: "center",
        gap: 6,
        padding: "4px 10px",
        fontSize: 12,
        color: "#94A3B8",
      }}
    >
      <span style={{ display: "flex", gap: 2 }}>
        <Dot delay={0} />
        <Dot delay={0.15} />
        <Dot delay={0.3} />
      </span>
      <span>{label} در حال نوشتن...</span>
    </div>
  );
}

function Dot(props) {
  const delay = props.delay;
  return (
    <span
      style={{
        width: 4,
        height: 4,
        borderRadius: "50%",
        background: "#94A3B8",
        display: "inline-block",
        animation: "typingBounce 1.2s infinite",
        animationDelay: delay + "s",
      }}
    />
  );
}

